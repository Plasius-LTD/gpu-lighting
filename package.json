{
  "name": "@plasius/gpu-lighting",
  "version": "0.2.14",
  "description": "Advanced lighting WGSL modules and planning profiles for @plasius/gpu-worker.",
  "type": "module",
  "sideEffects": false,
  "private": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "files": [
    "dist",
    "src",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "legal"
  ],
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./techniques/*": "./dist/techniques/*",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup && cp -R src/techniques dist/techniques",
    "baseline:fixed-spp": "node scripts/eames-environments/fixed-spp-baseline-capture.mjs",
    "demo": "python3 -m http.server --directory ..",
    "typecheck": "node --check src/index.js && node --check demo/lighting-demo-config.js && node --check demo/main.js && node --check demo/eames-environments/page.js && node --check demo/eames-environments/eames-loader.js && node --check demo/eames-environments/validation-scenes.js && node --check scripts/eames-environments/capture-runtime.mjs && node --check scripts/eames-environments/capture-server.mjs && node --check scripts/eames-environments/capture.mjs && node --check scripts/eames-environments/path-debug-capture.mjs && node --check scripts/eames-environments/capture-bridge-server.mjs && node --check scripts/eames-environments/fixed-spp-baseline-capture.mjs",
    "zero-three": "node scripts/verify-zero-three.cjs --package --evidence-out release-artifacts/zero-three-evidence.json",
    "zero-three:source": "node scripts/verify-zero-three.cjs --source-only",
    "zero-three:test": "node --test tests/zero-three.test.cjs",
    "audit:eslint": "eslint . --max-warnings=0",
    "audit:deps": "npm ls --all --omit=optional --omit=peer > /dev/null 2>&1 || true",
    "audit:npm": "npm audit --audit-level=high --omit=dev",
    "audit:test": "npm run test:coverage",
    "lint": "eslint . --max-warnings=0",
    "test": "npm run test:unit",
    "test:unit": "node --test",
    "test:e2e": "npx playwright install chromium && playwright test",
    "test:privacy": "node --test tests/public-package-policy.test.cjs",
    "test:coverage": "c8 --reporter=lcov --reporter=text node --test",
    "pack:check": "npm run privacy:check && node scripts/verify-public-package.cjs",
    "privacy:check": "node scripts/verify-public-artifacts.cjs --source-only",
    "prepublishOnly": "npm run build && npm run pack:check && npm run zero-three"
  },
  "keywords": [
    "webgpu",
    "lighting",
    "global-illumination",
    "lumen",
    "path-tracing",
    "volumetrics",
    "wgsl",
    "gpu",
    "compute",
    "plasius"
  ],
  "author": "Plasius LTD <development@plasius.co.uk>",
  "license": "Apache-2.0",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@plasius/gpu-debug": "^0.2.7",
    "@plasius/gpu-renderer": "^0.2.43",
    "@playwright/test": "^1.61.1",
    "c8": "^11.0.0",
    "eslint": "^10.6.0",
    "globals": "^17.7.0",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Plasius-LTD/gpu-lighting.git"
  },
  "bugs": {
    "url": "https://github.com/Plasius-LTD/gpu-lighting/issues"
  },
  "homepage": "https://github.com/Plasius-LTD/gpu-lighting#readme",
  "publishConfig": {
    "access": "public"
  },
  "funding": [
    {
      "type": "patreon",
      "url": "https://www.patreon.com/c/plasiusltd/membership"
    },
    {
      "type": "github",
      "url": "https://github.com/sponsors/Plasius-LTD"
    }
  ],
  "dependencies": {
    "@plasius/gpu-shared": "^1.1.0",
    "@plasius/gpu-worker": "^0.3.4"
  },
  "overrides": {
    "brace-expansion": "5.0.9",
    "esbuild": "0.28.1",
    "minimatch": "^10.2.1"
  },
  "engines": {
    "node": ">=24"
  }
}
